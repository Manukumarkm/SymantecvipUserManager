<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>SymantecVip.User</Name>
      <ViewSelectedBy><TypeName>SymantecVip.User</TypeName></ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>JurisdictionHash</PropertyName></ListItem>
              <ListItem><PropertyName>UserId</PropertyName></ListItem>
              <ListItem><PropertyName>UserStatus</PropertyName></ListItem>
              <ListItem><PropertyName>UserCreationTime</PropertyName></ListItem>
              <ListItem><PropertyName>NumBindings</PropertyName></ListItem>
              <ListItem>
                <Label>CredentialBindings</Label>
                <ScriptBlock>
                  if (-not $_.CredentialBindings) { '' }
                  else {
                    ($_.CredentialBindings | ForEach-Object {
                      "{0} ({1}) [{2}/{3}] {4}" -f $_.CredentialId, $_.CredentialType,
                          $_.CredentialStatus, $_.BindStatus, $_.FriendlyName
                    }) -join [Environment]::NewLine
                  }
                </ScriptBlock>
              </ListItem>
              <ListItem><PropertyName>Status</PropertyName></ListItem>
              <ListItem><PropertyName>StatusMessage</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>SymantecVip.ActionResult</Name>
      <ViewSelectedBy><TypeName>SymantecVip.ActionResult</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Operation</Label><Width>18</Width></TableColumnHeader>
          <TableColumnHeader><Label>Target</Label></TableColumnHeader>
          <TableColumnHeader><Label>OK</Label><Width>5</Width></TableColumnHeader>
          <TableColumnHeader><Label>Code</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>Message</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Operation</PropertyName></TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  $parts = @()
                  foreach ($n in 'UserId','TokenId','CredentialId','CredentialType','NewUserId','NewUserStatus','Type') {
                    if ($_.PSObject.Properties[$n] -and $_.$n) { $parts += $_.$n }
                  }
                  $parts -join ' / '
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem><PropertyName>Success</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>StatusCode</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>StatusMessage</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
